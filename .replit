modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 19316
externalPort = 80

[nix]
channel = "stable-25_05"
packages = ["alsa-lib", "at-spi2-atk", "at-spi2-core", "atk", "cairo", "chromium", "copilot-cli", "cups", "dbus", "expat", "glib", "gtk3", "libdrm", "libgbm", "libxkbcommon", "mesa", "nix-playground", "nspr", "nss", "pango", "pkg", "xorg.libX11", "xorg.libXScrnSaver", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXi", "xorg.libXrandr", "xorg.libXrender", "xorg.libXtst", "xorg.libxcb", "xorg.libxshmfence", "klibcShrunk"]

[deployment]
deploymentTarget = "autoscale"
